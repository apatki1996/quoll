{
  "name": "quoll",
  "displayName": "Quoll",
  "publisher": "apatki",
  "description": "Live runtime values inline, as you type — for JS/TS.",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/apatki/quoll"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quoll.start",
        "title": "Quoll: Start on Current File"
      },
      {
        "command": "quoll.stop",
        "title": "Quoll: Stop Session"
      },
      {
        "command": "quoll.copyValue",
        "title": "Copy Value",
        "icon": "$(copy)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "quollValues",
          "name": "Quoll Values",
          "icon": "$(symbol-value)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "quollValues",
        "contents": "No Quoll session is running.\n[Start Quoll](command:quoll.start)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "quoll.copyValue",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "quoll.copyValue",
          "when": "view == quollValues && viewItem == quollValue",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Quoll",
      "properties": {
        "quoll.denoPath": {
          "type": "string",
          "default": "deno",
          "description": "Path to the Deno executable used for the runner sandbox."
        },
        "quoll.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "Delay after the last edit before re-running the file."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "pnpm run build:core && pnpm run build",
    "build:core": "node scripts/build-core.mjs",
    "check:phase3": "node scripts/phase3-check.mjs",
    "check:phase5": "node scripts/phase5-check.mjs",
    "eval": "node eval/run.mjs",
    "fmt": "oxfmt && cargo fmt --manifest-path crates/quoll-core/Cargo.toml",
    "fmt:check": "oxfmt --check && cargo fmt --manifest-path crates/quoll-core/Cargo.toml --check"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "esbuild": "^0.25.0",
    "oxfmt": "^0.54.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@11.5.2"
}
