{
  "name": "quoll",
  "displayName": "Quoll",
  "publisher": "apatki",
  "description": "Live runtime values inline, as you type — for JS/TS.",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/apatki/quoll"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quoll.start",
        "title": "Quoll: Start on Current File"
      },
      {
        "command": "quoll.stop",
        "title": "Quoll: Stop Session"
      },
      {
        "command": "quoll.copyValue",
        "title": "Copy Value",
        "icon": "$(copy)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "quollValues",
          "name": "Quoll Values",
          "icon": "$(symbol-value)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "quollValues",
        "contents": "No Quoll session is running.\n[Start Quoll](command:quoll.start)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "quoll.copyValue",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "quoll.copyValue",
          "when": "view == quollValues && viewItem == quollValue",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Quoll",
      "properties": {
        "quoll.denoPath": {
          "type": "string",
          "default": "deno",
          "scope": "machine",
          "description": "Path to the Deno executable used for the runner sandbox. Machine-scoped: settable only in user or remote settings — a workspace's .vscode/settings.json cannot override it, so a cloned repo can never redirect the sandbox binary."
        },
        "quoll.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "Delay after the last edit before re-running the file."
        },
        "quoll.values": {
          "type": "string",
          "enum": [
            "all",
            "comments"
          ],
          "enumDescriptions": [
            "Always-on: show the value of every expression inline.",
            "Quiet: show inline values only on lines you opt into with a //? comment. //?. timings and console output still show."
          ],
          "default": "all",
          "description": "Which inline runtime values to show. 'all' is Quoll's always-on default; 'comments' shows only //?-annotated lines."
        }
      }
    }
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "pnpm run typecheck && node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "build:tests": "node esbuild.mjs --test",
    "pretest": "pnpm run typecheck:tests && pnpm run build && pnpm run build:tests",
    "test": "vscode-test",
    "vscode:prepublish": "pnpm run build:core && pnpm run package",
    "build:core": "node scripts/build-core.mjs",
    "check:phase3": "node scripts/phase3-check.mjs",
    "check:phase5": "node scripts/phase5-check.mjs",
    "check:bundle": "node scripts/check-native-bundle.mjs",
    "eval": "node eval/run.mjs",
    "fmt": "oxfmt && cargo fmt --manifest-path crates/quoll-core/Cargo.toml",
    "fmt:check": "oxfmt --check && cargo fmt --manifest-path crates/quoll-core/Cargo.toml --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "lint:rust": "cargo clippy --manifest-path crates/quoll-core/Cargo.toml --all-targets -- -D warnings"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.5.2"
}
