{
  "name": "quoll",
  "displayName": "Quoll",
  "publisher": "apatki",
  "description": "Live runtime values inline, as you type — for JS/TS.",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/apatki1996/quoll"
  },
  "bugs": {
    "url": "https://github.com/apatki1996/quoll/issues"
  },
  "homepage": "https://github.com/apatki1996/quoll#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Visualization"
  ],
  "keywords": [
    "scratchpad",
    "repl",
    "live",
    "inline values",
    "quokka"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quoll.start",
        "title": "Quoll: Start on Current File"
      },
      {
        "command": "quoll.stop",
        "title": "Quoll: Stop Session"
      },
      {
        "command": "quoll.copyValue",
        "title": "Copy Value",
        "icon": "$(copy)"
      },
      {
        "command": "quoll.exploreValue",
        "title": "Explore Value"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "quollValues",
          "name": "Quoll Values",
          "icon": "$(symbol-value)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "quollValues",
        "contents": "No Quoll session is running.\n[Start Quoll](command:quoll.start)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "quoll.copyValue",
          "when": "false"
        },
        {
          "command": "quoll.exploreValue",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "quoll.copyValue",
          "when": "view == quollValues && viewItem == quollValue",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Quoll",
      "properties": {
        "quoll.denoPath": {
          "type": "string",
          "default": "deno",
          "scope": "machine",
          "description": "Path to the Deno executable used for the runner sandbox. Machine-scoped: settable only in user or remote settings — a workspace's .vscode/settings.json cannot override it, so a cloned repo can never redirect the sandbox binary."
        },
        "quoll.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "Delay after the last edit before re-running the file."
        },
        "quoll.runTimeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 200,
          "maximum": 600000,
          "description": "How long a run may keep waiting for outstanding timers and promises to settle before it gives up. Quoll stays alive while they are pending — a setTimeout of 8s still shows its value — so this is the ceiling that stops a setInterval from running forever."
        },
        "quoll.values": {
          "type": "string",
          "enum": [
            "all",
            "comments"
          ],
          "enumDescriptions": [
            "Always-on: show the value of every expression inline.",
            "Quiet: show inline values only on lines you opt into — a //? comment, the current selection, or a breakpoint. //?. timings and console output still show."
          ],
          "default": "all",
          "description": "Which inline runtime values to show. 'all' is Quoll's always-on default; 'comments' shows only lines you opt into with a //? comment, a selection, or a breakpoint."
        }
      }
    }
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "pnpm run typecheck && node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "build:tests": "node esbuild.mjs --test",
    "pretest": "pnpm run typecheck:tests && pnpm run build && pnpm run build:tests",
    "test": "vscode-test",
    "vscode:prepublish": "pnpm run build:core && pnpm run package",
    "build:core": "node scripts/build-core.mjs",
    "check:phase3": "node scripts/phase3-check.mjs",
    "check:phase5": "node scripts/phase5-check.mjs",
    "check:bundle": "node scripts/check-native-bundle.mjs",
    "check:timeout": "node scripts/timeout-check.mjs",
    "test:unit": "deno check runner/main.ts && deno test --allow-read --allow-write --allow-run --allow-env --allow-sys src/render src/instrument src/runner runner",
    "eval": "node eval/run.mjs",
    "fmt": "oxfmt && cargo fmt --manifest-path crates/quoll-core/Cargo.toml",
    "fmt:check": "oxfmt --check && cargo fmt --manifest-path crates/quoll-core/Cargo.toml --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "lint:rust": "cargo clippy --manifest-path crates/quoll-core/Cargo.toml --all-targets -- -D warnings"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.3.0",
    "@types/vscode": "~1.96.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.5.2"
}
